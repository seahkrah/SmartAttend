# =============================================================================
# ROOT .gitignore — JjeloTech Platform
# =============================================================================
# Enforces strict repository hygiene: only source code, configs, and lockfiles
# System must be 100% reproducible from lockfiles, manifests, and Docker config

# =============================================================================
# RUNTIME ARTIFACTS (STRICTLY FORBIDDEN)
# =============================================================================

# Node.js
node_modules/
npm-debug.log
yarn-error.log
pnpm-debug.log
lerna-debug.log
.npm/
.yarn/cache/
.yarn/install-state.gz

# Python
__pycache__/
.venv/
venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Package Manager Lock Artifacts (only .lock files allowed, not cache)
.pnp
.pnp.js

# =============================================================================
# BUILD OUTPUTS (auto-generated, must not be committed)
# =============================================================================

dist/
build/
*.o
*.so
*.dylib

# Frontend builds
apps/frontend/dist/
apps/frontend/.next/
apps/frontend/out/
apps/frontend/build/

# Backend builds  
apps/backend/dist/
apps/backend/build/

# =============================================================================
# LOGS & RUNTIME DATA (STRICTLY FORBIDDEN)
# =============================================================================

*.log
*.logs
logs/
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
backend.log
frontend.log
server.log
**/.DS_Store

# =============================================================================
# ENVIRONMENT & SECRETS (STRICTLY FORBIDDEN)
# =============================================================================

.env
.env.local
.env.*.local
.env.production.local
.env.development.local
.env.test.local
.env.*.private
.env.*.secret
# Hand-made copies of a real .env (e.g. .env.smartattend-backup)
.env.*backup
.env.*bak

# Leftovers of the retired Django rebuild (branch feat/jjelotech-mvp):
# caches, a virtualenv, a build and a .env. Its source lives only on that branch.
/jjelotech/

