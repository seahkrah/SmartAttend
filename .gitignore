# =============================================================================
# PLATFORM-SPECIFIC
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
.directory

# =============================================================================
# DOCKER & CONTAINER ARTIFACTS
# =============================================================================

.dockerignore
docker-compose.override.yml

# =============================================================================
# DEPENDENCY VERIFICATION
# =============================================================================
# Only the following files are allowed in version control:
# - package.json (manifest)
# - package-lock.json (lockfile)
# - pnpm-lock.yaml (lockfile)
# - yarn.lock (lockfile)
# - requirements.txt (Python manifest)
# - Pipfile / Pipfile.lock (Python lockfiles)
# - tsconfig.json (TypeScript config)
# - Dockerfile (reproducible builds)
# - docker-compose.yml (orchestration)

# Explicitly ALLOW lockfiles
!package-lock.json
!pnpm-lock.yaml
!yarn.lock
!Pipfile.lock
!requirements.txt

# Explicitly ALLOW configs
!tsconfig.json
!Dockerfile
!docker-compose.yml
!.dockerignore

# ── Credentials (never commit) ─────────────────────────────────────────────
# Plaintext account passwords were committed to this repository once; see
# SECURITY_CREDENTIAL_ROTATION.md. These patterns stop it happening again.
*credentials*.txt
*passwords*.txt
*Passwords*.txt
rotated-credentials-*.txt
.e2e-fixtures/

# Locally stored documents. FILE_STORAGE_ROOT points elsewhere in a real
# deployment; this is where it lands by default in development.
.file-storage/
apps/backend/.file-storage/

# ── Repository hygiene (scripts/checks/repo-hygiene.mjs enforces these) ────
# One-off debug and repair scripts belong in apps/backend/src/scripts/ with a
# README entry, or nowhere. The backend root keeps only its manifests,
# configs and setup-superadmin.ts.
/apps/backend/*.js
/apps/backend/*.cjs
/apps/backend/*.mjs
/apps/backend/*.ts
!/apps/backend/setup-superadmin.ts
!/apps/backend/vitest.config.ts
# Phase write-ups and component "specs" at the root: docs/ is the place.
/*.ts
/*.tsx
/*.ps1
/*.sh
# Superseded migrations are deleted, not kept beside their replacement.
*_OLD.sql
# Local Claude Code state and scratch copies.
/.claude/settings.local.json
/.claude/*.html
# Scorecard tooling dependencies.
/scripts/scorecard/node_modules/
apps/frontend/test-results/
apps/frontend/playwright-report/
