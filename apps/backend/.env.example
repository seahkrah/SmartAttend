# Backend configuration. Copy to .env and fill in. Never commit .env.
#
# In production (NODE_ENV=production) the server refuses to start if
# JWT_SECRET, DATABASE_URL, PUBLIC_APP_URL or CORS_ORIGINS is missing or looks
# like a placeholder (src/config/validateEnv.ts).

NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/jjelotech
# TLS to the database: "verify" (the default in production; the server's
# certificate must check out, against DATABASE_SSL_CA if set) or "off" (only
# for a database reachable solely on a private network).
DATABASE_SSL=
DATABASE_SSL_CA=

# Signs access tokens. At least 32 random characters, different per
# environment. Generate with: openssl rand -base64 48
JWT_SECRET=

# Seals two-factor (authenticator app) secrets at rest. 32 bytes, base64:
# openssl rand -base64 32. Unset, a key is derived from JWT_SECRET, which then
# can never be rotated without everyone setting up two-factor again.
MFA_ENCRYPTION_KEY=
# Roles that must use two-factor sign-in, comma-separated. Unset: superadmin
# and admin in production, nobody in development. Empty to require nobody.
# MFA_REQUIRED_ROLES=superadmin,admin

# Where the web app is served. Invitation and password-reset emails link here;
# must be https:// in production.
PUBLIC_APP_URL=http://localhost:5173

# Browser origins allowed to call the API, comma-separated. Development falls
# back to the local Vite/preview ports when this is empty.
CORS_ORIGINS=

# How many proxies (load balancer, ingress) sit in front of the API, or their
# addresses. Leave empty when clients connect directly: forwarding headers are
# then ignored, so a client cannot choose the address it is recorded under.
TRUST_PROXY=

# Request limits per client address. Many users behind one school or office
# NAT share an address, so these are generous; the per-account sign-in lockout
# (5 failures in 15 minutes) does not depend on them.
RATE_LIMIT_API_PER_MINUTE=3000
RATE_LIMIT_LOGIN_PER_MINUTE=120
RATE_LIMIT_REFRESH_PER_MINUTE=600
RATE_LIMIT_ACCOUNT_PER_15MIN=30
RATE_LIMIT_MFA_PER_15MIN=60

# Required (32+ characters) to create a superadmin in production, and to
# create any superadmin after the first. Send it as the X-Bootstrap-Token header.
SUPERADMIN_BOOTSTRAP_TOKEN=

# Face matching: 32-byte key, base64, that seals face templates at rest.
# Generate with: openssl rand -base64 32. See docs/features/face-matching.md.
BIOMETRIC_TEMPLATE_KEY=
BIOMETRIC_TEMPLATE_KEY_VERSION=1
# During a key rotation, the key being retired and its version:
BIOMETRIC_TEMPLATE_KEY_PREVIOUS=
BIOMETRIC_TEMPLATE_KEY_PREVIOUS_VERSION=
FACE_ENGINE_CONCURRENCY=2

# Uploaded documents.
FILE_STORAGE_BACKEND=local
FILE_STORAGE_ROOT=./storage

# Set to "on" to deliver queued notifications from this process.
NOTIFICATION_DISPATCH=off
