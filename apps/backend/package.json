{
  "name": "jjelotech-backend",
  "version": "1.0.0",
  "description": "JJELOTECH backend API",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "setup-superadmin": "tsx setup-superadmin.ts",
    "verify-face-engine": "tsx src/scripts/verifyFaceEngine.ts",
    "tfjs-native": "node scripts/tfjs-native.mjs",
    "postinstall": "node -e \"const f='scripts/tfjs-native.mjs';if(require('fs').existsSync(f))require('child_process').execFileSync(process.execPath,[f,'--stage'],{stdio:'inherit'})\"",
    "lint": "eslint . --max-warnings 45",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@jjelotech/types": "file:../../packages/types",
    "@tensorflow/tfjs-node": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "axios": "^1.6.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.11.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.30",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.16.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "node-mocks-http": "^1.18.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "tar": "^7.5.22",
    "adm-zip": "^0.6.1",
    "@mapbox/node-pre-gyp": "^2.0.3"
  }
}
