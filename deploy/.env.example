# Settings for deploy/docker-compose.yml. Copy to deploy/.env; never commit it.
# Generate secrets with: openssl rand -base64 48

POSTGRES_PASSWORD=
JWT_SECRET=
# 32 bytes, base64 (openssl rand -base64 32). Seals two-factor secrets.
MFA_ENCRYPTION_KEY=
# Where people open the web app, and where the browser reaches the API.
PUBLIC_APP_URL=https://app.example.org
API_PUBLIC_URL=https://api.example.org
# 32 bytes, base64 (openssl rand -base64 32). Needed only for face matching.
BIOMETRIC_TEMPLATE_KEY=
# Needed to create the first superadmin through the API (32+ characters).
SUPERADMIN_BOOTSTRAP_TOKEN=
TRUST_PROXY=1
API_PORT=5000
WEB_PORT=8080
