{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "lib": ["ES2020"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    // node16 emits CommonJS here (package.json has no "type": "module") and is
    // accepted by the locked TypeScript 5.9 and by later versions alike. The
    // previous "node" + ignoreDeprecations "6.0" only built with a newer
    // global tsc; the locked 5.9 rejects that flag value.
    "moduleResolution": "node16"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
